# LLM Configuration (ollama, openrouter, gemini, openai, anthropic)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Optional OpenRouter Free Models Fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free

# Instagram & Facebook Accounts
IG_USERNAME=your_ig_username
FB_USERNAME=your_fb_username

# Studio Server Configuration
HOST=127.0.0.1
PORT=8005
DEBUG=True
